rules_version = '2';

// Firestore security rules for Pickup-Finder.
//
// These rules are the real enforcement. The front end (events.js) checks the
// same things first so it can show friendly errors, but anyone can call
// Firestore directly, so anything that matters must be checked here too.
//
// Deploying this file REPLACES every rule in the Firebase project, so any
// collection not listed here becomes unreadable and unwritable.
//
// Test with: npm test   (see README.md in this folder)

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Keep in sync with SPORTS in events.js. Used by events and by
    // notification settings.
    function sports() {
      return ['basketball', 'soccer', 'volleyball', 'tennis', 'pickleball', 'football'];
    }

    // ------------------------------------------------------------------
    // users/{uid}: profiles written by the registration page.
    // Minimal rule so registration keeps working; the profile team should
    // tighten it (field validation, what other users may see).
    // ------------------------------------------------------------------
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // events/{eventId}: pickup games. See README.md for the data model.
    // ------------------------------------------------------------------
    match /events/{eventId} {

      // Keep in sync with SKILL_LEVELS and the limits in events.js.
      function eventFields() {
        return ['sportId', 'title', 'description', 'skillLevel', 'startTime', 'endTime',
                'location', 'playerLimit', 'hostId', 'hostName', 'participantIds',
                'status', 'createdAt'];
      }

      // Fields the host may change after creating the event.
      function hostEditableFields() {
        return ['title', 'description', 'skillLevel', 'startTime', 'endTime',
                'location', 'playerLimit', 'status'];
      }

      function validLocation(loc) {
        return loc is map
          && loc.keys().hasAll(['name', 'address', 'lat', 'lng'])
          && loc.keys().hasOnly(['name', 'address', 'lat', 'lng'])
          && loc.name is string && loc.name.size() > 0 && loc.name.size() <= 100
          && loc.address is string && loc.address.size() <= 200
          && loc.lat is number && loc.lat >= -90 && loc.lat <= 90
          && loc.lng is number && loc.lng >= -180 && loc.lng <= 180;
      }

      // Shape and values every event document must have, on create and on
      // every host edit.
      function validEvent(e) {
        return e.keys().hasAll(eventFields())
          && e.keys().hasOnly(eventFields())
          && e.sportId in sports()
          && e.title is string && e.title.size() <= 60
          && e.description is string && e.description.size() <= 500
          && e.skillLevel in ['casual', 'competitive']
          && e.startTime is timestamp && e.startTime > request.time
          && e.endTime is timestamp && e.endTime > e.startTime
          && e.endTime <= e.startTime + duration.value(12, 'h')
          && validLocation(e.location)
          && e.playerLimit is int && e.playerLimit >= 2 && e.playerLimit <= 50
          && e.participantIds is list && e.participantIds.size() <= e.playerLimit
          && e.hostId is string
          && e.hostName is string && e.hostName.size() <= 60
          && e.status in ['scheduled', 'cancelled'];
      }

      // Create: you are the host, you are the only player, and it starts
      // out scheduled.
      function validNewEvent() {
        let e = request.resource.data;
        return validEvent(e)
          && e.hostId == request.auth.uid
          && e.participantIds == [request.auth.uid]
          && e.status == 'scheduled'
          && e.createdAt == request.time;
      }

      function onlyParticipantsChanged() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds']);
      }

      // RSVP: add exactly yourself, once, without going over the limit.
      // Writes to one document are applied one at a time, so two people
      // racing for the last spot can't both get in.
      function isJoin() {
        let before = resource.data.participantIds;
        let after = request.resource.data.participantIds;
        return onlyParticipantsChanged()
          && !(request.auth.uid in before)
          && after.size() == before.size() + 1
          && after.toSet() == before.toSet().union([request.auth.uid].toSet())
          && after.size() <= resource.data.playerLimit;
      }

      // Cancel RSVP: remove exactly yourself. The host can't leave; they
      // cancel the event instead.
      function isLeave() {
        let before = resource.data.participantIds;
        let after = request.resource.data.participantIds;
        return onlyParticipantsChanged()
          && request.auth.uid in before
          && request.auth.uid != resource.data.hostId
          && after.size() == before.size() - 1
          && after.toSet() == before.toSet().difference([request.auth.uid].toSet());
      }

      // Host edit: details and status only (status can go to 'cancelled').
      // The host can't change who is going or hand the event to someone else.
      function isHostEdit() {
        return request.auth.uid == resource.data.hostId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(hostEditableFields())
          && validEvent(request.resource.data);
      }

      allow read: if signedIn();

      allow create: if signedIn() && validNewEvent();

      // Nothing changes once an event is cancelled or has started.
      allow update: if signedIn()
        && resource.data.status == 'scheduled'
        && resource.data.startTime > request.time
        && (isJoin() || isLeave() || isHostEdit());

      // Cancel instead of deleting, so players still see what happened.
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Sportsmanship feedback (GitHub issue #13). See sportsmanship.js.
    //
    // feedback/{eventId}_{fromId}_{toId}: one rating from one player to
    // another for one finished game. sportsmanship/{uid}: that player's
    // running totals. Both are written together in one batch, and each
    // rule checks the other document with getAfter(), so the totals always
    // equal the number of feedback documents and nobody can add to them
    // without leaving real feedback.
    // ------------------------------------------------------------------

    function eventDoc(eventId) {
      return /databases/$(database)/documents/events/$(eventId);
    }

    function feedbackDoc(feedbackId) {
      return /databases/$(database)/documents/feedback/$(feedbackId);
    }

    function sportsmanshipDoc(uid) {
      return /databases/$(database)/documents/sportsmanship/$(uid);
    }

    match /feedback/{feedbackId} {

      function feedbackFields() {
        return ['eventId', 'sportId', 'fromId', 'toId', 'rating', 'comment', 'createdAt'];
      }

      // Keep in sync with RATINGS, MAX_COMMENT and FEEDBACK_WINDOW_DAYS in
      // sportsmanship.js.
      function validShape(f) {
        return f.keys().hasAll(feedbackFields())
          && f.keys().hasOnly(feedbackFields())
          && f.eventId is string && f.fromId is string && f.toId is string
          && feedbackId == f.eventId + '_' + f.fromId + '_' + f.toId
          && f.rating in ['positive', 'negative']
          && f.comment is string && f.comment.size() <= 300
          && f.createdAt == request.time;
      }

      // You rate someone else, both of you played in the game, the game
      // wasn't cancelled, and it ended within the last 14 days.
      function playedTogether(f) {
        let game = get(eventDoc(f.eventId)).data;
        return game.status == 'scheduled'
          && game.endTime < request.time
          && request.time < game.endTime + duration.value(14, 'd')
          && f.fromId in game.participantIds
          && f.toId in game.participantIds
          && f.sportId == game.sportId;
      }

      allow read: if signedIn();

      // The document ID makes this one rating per rater, per player, per
      // game: rating the same person again is an update, which is denied.
      allow create: if signedIn()
        && validShape(request.resource.data)
        && request.resource.data.fromId == request.auth.uid
        && request.resource.data.toId != request.auth.uid
        && playedTogether(request.resource.data)
        && getAfter(sportsmanshipDoc(request.resource.data.toId)).data.lastFeedbackId == feedbackId;

      // Feedback is permanent, like eBay's: nobody can edit or remove it,
      // including the person who got it.
      allow update, delete: if false;
    }

    match /sportsmanship/{userId} {

      // The only allowed write: add exactly one to the counter that matches
      // a feedback document created in this same batch, for this player, by
      // the signed-in user. lastFeedbackId points at that document.
      function countsNewFeedback(positiveBefore, negativeBefore) {
        let s = request.resource.data;
        let fb = feedbackDoc(s.lastFeedbackId);
        let f = getAfter(fb).data;
        return s.keys().hasAll(['positive', 'negative', 'lastFeedbackId', 'updatedAt'])
          && s.keys().hasOnly(['positive', 'negative', 'lastFeedbackId', 'updatedAt'])
          && s.lastFeedbackId is string
          && s.positive is int && s.negative is int
          && s.updatedAt == request.time
          && !exists(fb)
          && existsAfter(fb)
          && f.toId == userId
          && f.fromId == request.auth.uid
          && s.positive == positiveBefore + (f.rating == 'positive' ? 1 : 0)
          && s.negative == negativeBefore + (f.rating == 'negative' ? 1 : 0);
      }

      // Public, so other players can see who's a good sport.
      allow read: if signedIn();

      // A player's first feedback creates the document.
      allow create: if signedIn() && countsNewFeedback(0, 0);
      allow update: if signedIn()
        && countsNewFeedback(resource.data.positive, resource.data.negative);

      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Notifications (GitHub issue #17). See notifications.js and ../notifier/.
    //
    // notificationSettings/{uid}: how and when a player wants to hear from
    // us. It holds their phone number and browser push tokens, so only its
    // owner can read or change it.
    //
    // notifications/{id}: every message the notifier sent, for the in-app
    // inbox. Only the notifier writes these, with the Admin SDK, which skips
    // these rules. Players can read their own and mark them read.
    //
    // notifier/{doc}: the notifier's own bookkeeping. There's no rule for
    // it, so no browser can read or write it.
    // ------------------------------------------------------------------

    match /notificationSettings/{userId} {

      // Keep in sync with cleanSettings() and the limits in notifications.js.
      function settingsFields() {
        return ['channels', 'phone', 'desktopTokens', 'gameReminders',
                'feedbackReminders', 'matchAlerts', 'updatedAt'];
      }

      function validChannels(c) {
        return c is map
          && c.keys().hasAll(['email', 'sms', 'desktop'])
          && c.keys().hasOnly(['email', 'sms', 'desktop'])
          && c.email is bool && c.sms is bool && c.desktop is bool;
      }

      // Match alerts for games near a point, or anywhere (null).
      function validNear(n) {
        return n == null || (n is map
          && n.keys().hasAll(['lat', 'lng', 'radiusKm'])
          && n.keys().hasOnly(['lat', 'lng', 'radiusKm'])
          && n.lat is number && n.lat >= -90 && n.lat <= 90
          && n.lng is number && n.lng >= -180 && n.lng <= 180
          && n.radiusKm is number && n.radiusKm >= 1 && n.radiusKm <= 100);
      }

      function validMatchAlerts(m) {
        return m is map
          && m.keys().hasAll(['sportIds', 'skillLevel', 'near', 'minScore'])
          && m.keys().hasOnly(['sportIds', 'skillLevel', 'near', 'minScore'])
          && m.sportIds is list
          && m.sportIds.size() <= sports().size()
          && m.sportIds.hasOnly(sports())
          && m.skillLevel in ['any', 'casual', 'competitive']
          && validNear(m.near)
          && m.minScore is number && m.minScore >= 0 && m.minScore <= 100;
      }

      // Text messages need a phone number, and desktop notifications need
      // at least one browser that was set up for them.
      function validSettings(s) {
        return s.keys().hasAll(settingsFields())
          && s.keys().hasOnly(settingsFields())
          && validChannels(s.channels)
          && s.phone is string
          && (s.phone == '' || s.phone.matches('[+][1-9][0-9]{7,14}'))
          && (!s.channels.sms || s.phone != '')
          && s.desktopTokens is list && s.desktopTokens.size() <= 5
          && (!s.channels.desktop || s.desktopTokens.size() > 0)
          && s.gameReminders is bool && s.feedbackReminders is bool
          && validMatchAlerts(s.matchAlerts)
          && s.updatedAt == request.time;
      }

      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && validSettings(request.resource.data);
    }

    match /notifications/{notificationId} {

      // Lists must filter on uid == your own ID, or Firestore refuses them.
      allow read: if signedIn() && resource.data.uid == request.auth.uid;

      // Marking one read is the only change a player can make. Deleting is
      // off because the notifier uses these documents to remember what it
      // already sent: a deleted reminder would be sent again.
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time;

      allow create, delete: if false;
    }
  }
}
