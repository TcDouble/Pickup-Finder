# Copy to .env.test for the local Docker test stack (.env.test is git-ignored).
# The Firebase emulators need no passwords or keys, so there are no secrets here.
NODE_ENV=test
# The tests refuse to run unless the project ID starts with "demo-": a demo
# project can only talk to the local emulators, never the live Firebase
# project. This is the Firebase version of the lab's "_test" database rule.
# npm test uses this same ID (set in package.json), so keep them matching.
FIREBASE_PROJECT_ID=demo-pickup-finder
