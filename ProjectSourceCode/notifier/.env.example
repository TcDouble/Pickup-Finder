# Settings for the notifier. Copy this file to .env (in this folder) and fill
# in what you have. A channel left empty isn't sent: the notifier prints those
# messages in its log instead, which is enough for a demo.
#
# Never commit .env or service-account.json. Both are in .gitignore.

# The Firebase project to watch.
FIREBASE_PROJECT_ID=sport-pick-up-app-team-4

# Only when running without Docker (npm start): the service account key file.
# Docker sets this itself from service-account.json.
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# How often to check for games to notify about, in seconds (10 or more).
POLL_SECONDS=60

# The site's address, for the links in messages. Desktop notifications only
# open the link when it starts with https://.
APP_URL=http://localhost:3000

# Times in messages are shown in this time zone.
TIME_ZONE=America/Denver

# Email, through any SMTP account. For Gmail: turn on 2-Step Verification,
# create an app password (Google Account > Security > App passwords), and
# write it without spaces. The @ in the address is written %40:
#   SMTP_URL=smtps://you%40gmail.com:abcdefghijklmnop@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM="Pickup-Finder <you@gmail.com>"

# Text messages, through Twilio (Console > Account info). A free trial account
# can only text numbers you've verified in Twilio, which is fine for a demo.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number messages come from, like +17205550123.
TWILIO_FROM=

# Desktop notifications go through Firebase Cloud Messaging with the service
# account, so they need no other account. Set this to off to stop them.
DESKTOP_PUSH=on
